# Copia este archivo como ".env" (en la raíz del proyecto) y completa los valores reales.
# NUNCA subas el archivo ".env" con valores reales al control de versiones.
#
# Se obtienen en supabase.com -> tu proyecto -> Project Settings -> API.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=TU-ANON-PUBLIC-KEY

# Esquema de redirección usado por el flujo de OAuth (Google/Apple).
# Debe coincidir con el intent-filter de Android y el URL scheme de iOS.
SUPABASE_AUTH_REDIRECT=io.supabase.petcarehomeservices://login-callback
